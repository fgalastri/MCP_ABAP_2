# SAP ABAP System Configuration
# Copy this file to .env and update with your actual SAP system details

# SAP System Base URL (including protocol and port)
SAP_BASE_URL=https://your-sap-system.com:8000

# SAP Authentication
SAP_USERNAME=your_username
SAP_PASSWORD=your_password

# SAP Client Number
SAP_CLIENT=100

# Optional: Additional Configuration
# SAP_LANGUAGE=EN
# SAP_DEBUG=false
